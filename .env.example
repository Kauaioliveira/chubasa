# Copie para .env (PowerShell: Copy-Item .env.example .env) e ajuste.
# Nenhuma chave de API vai aqui: o Chubasa usa o login do plano Pro.

# Palavra-chave e idioma (obrigatórios)
WAKE_WORD=hey chubasa
LANGUAGE=pt

# Microfone: vazio = padrão do sistema. Aceita o número ou parte do nome
# (veja a lista com: python -m chubasa dispositivos)
MIC_DEVICE=

# DEBUG, INFO, WARNING ou ERROR
LOG_LEVEL=INFO
