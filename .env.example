# Copie para .env (PowerShell: Copy-Item .env.example .env) e ajuste.
# Nenhuma chave de API vai aqui: o Chubasa usa o login do plano Pro.

# Palavra-chave e idioma (obrigatórios)
WAKE_WORD=hey chubasa
LANGUAGE=pt

# Microfone: vazio = padrão do sistema. Aceita o número ou parte do nome
# (veja a lista com: python -m chubasa dispositivos)
MIC_DEVICE=

# DEBUG, INFO, WARNING ou ERROR
LOG_LEVEL=INFO

# Pasta dos modelos baixados/treinados (relativa à raiz do projeto)
MODELS_DIR=models

# Wake word. Enquanto models/hey_chubasa.onnx não existir, o Chubasa usa o modelo
# pronto "hey jarvis" (diga "hey jarvis" para testar). Treino: veja treino/LEIA-ME.md
WAKE_MODEL_PATH=models/hey_chubasa.onnx
# Score mínimo (0 a 1) para considerar que ouviu a palavra-chave
WAKE_THRESHOLD=0.5
# Segundos ignorando novas detecções depois de uma detecção
WAKE_COOLDOWN_S=2.0

# Verificação de voz: só a voz cadastrada ativa o Chubasa.
# Cadastre com: python -m chubasa cadastrar-voz (precisa do grupo "voz": pip install -e ".[voz]")
# Sem cadastro, qualquer voz ativa (o log avisa).
SPEAKER_VERIFY=true
SPEAKER_PROFILE_PATH=models/voz.npy
# Similaridade mínima (-1 a 1) com a voz cadastrada. Calibre pelo "voz: score=" do log.
SPEAKER_THRESHOLD=0.40

# Gravação do comando depois do bip (Silero VAD, local)
# Probabilidade mínima (0 a 1) para considerar que é fala
VAD_THRESHOLD=0.5
# Segundos de silêncio que encerram o comando
VAD_SILENCE_END_S=1.0
# Se ninguém falar nesse tempo depois do bip, volta a dormir
VAD_NO_SPEECH_TIMEOUT_S=5.0
# Duração máxima de um comando
VAD_MAX_RECORDING_S=30.0
# Segundos de áudio antes do início da fala que entram na gravação (não corta a 1ª sílaba)
VAD_PREROLL_S=0.3

# Fala para texto (faster-whisper, local). Na primeira vez o modelo é baixado para models/whisper.
# small: melhor qualidade; base: ~3x mais rápido em máquina fraca; tiny: só para teste
STT_MODEL=small
# cpu (padrão, funciona em qualquer máquina) ou cuda (só NVIDIA com driver/CUDA 12)
STT_DEVICE=cpu
# int8 na CPU; float16 na GPU
STT_COMPUTE_TYPE=int8
# 1 = mais rápido; 5 = um pouco mais preciso e mais lento
STT_BEAM_SIZE=1
# Threads da CPU (0 = automático)
STT_CPU_THREADS=0

# Conversa com o Claude (Claude Agent SDK, login do plano Pro; sem chave de API)
# sonnet (padrão), haiku (mais rápido e mais simples) ou opus
BRAIN_MODEL=sonnet
# Segundos esperando o primeiro trecho da resposta e a resposta inteira
BRAIN_TIMEOUT_FIRST_S=30
BRAIN_TIMEOUT_TOTAL_S=90

# Texto para fala. piper = local (padrão); edge = voz da Microsoft pela internet
# (precisa de: python -m pip install -e ".[edge]")
TTS_ENGINE=piper
# Voz do Piper, baixada na primeira vez para models/piper (pt_BR-faber-medium, pt_BR-cadu-medium...)
TTS_VOICE=pt_BR-faber-medium
# Voz do Edge TTS (pt-BR-AntonioNeural, pt-BR-FranciscaNeural...)
TTS_EDGE_VOICE=pt-BR-AntonioNeural

# Loop principal
# Depois de responder, escuta por N segundos sem precisar da palavra-chave (0 = desliga)
LOOP_CONVERSATION_S=6
# Interromper a fala dizendo a palavra-chave (só funciona com a voz cadastrada)
LOOP_BARGE_IN=true
# Score mínimo da palavra-chave para interromper (mais alto que WAKE_THRESHOLD, por segurança)
LOOP_BARGE_IN_THRESHOLD=0.8

# Ferramentas: hora/data, timers/lembretes e abrir programas (true/false)
TOOLS_ENABLED=true
# Programas que podem ser abertos por voz, no formato nome:comando separados por ";".
# Só estes; o assistente nunca abre outro caminho.
TOOLS_PROGRAMS=bloco de notas:notepad.exe;calculadora:calc.exe;chrome:chrome.exe;navegador:chrome.exe
